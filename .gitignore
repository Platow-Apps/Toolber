# dependencies
node_modules

# build output
dist
dist-ssr

# test coverage report (npm run test:ava:coverage)
coverage

# env files (never commit real secrets)
.env
.env.local
.env.*.local

# claude code local-only settings (personal permission overrides, not shared config)
.claude/settings.local.json

# editor
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# vite pwa generated files
dev-dist

# Supabase CLI local link/session cache — machine-specific, not shared config
supabase/.temp

# Local stack state, written by `supabase start` / `supabase db reset`. Holds a
# dump of the local database, which is disposable by design: it is rebuilt from
# supabase/migrations every time. Nothing here belongs to anyone but this machine.
supabase/.branches

# the user's own working screenshots/reference images, not a repo asset
/Screenshots

# Written by `npm run test:functions`; the deploy resolves its own versions.
deno.lock
