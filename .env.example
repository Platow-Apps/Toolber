# Copy this file to .env and fill in real values. Never commit .env itself.

# Supabase project settings (Project Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapbox public token (mapbox.com → Account → Tokens). This is a client-exposed
# token by design (Mapbox scopes it), not a secret — safe to ship in the bundle.
VITE_MAPBOX_TOKEN=

# NOTE: the Resend API key is server-side only (used by the Supabase `notify`
# Edge Function), never a VITE_ variable — it must never ship to the client.
# Set it via `supabase secrets set RESEND_API_KEY=...` instead.

# Cloudflare Turnstile site key (dash.cloudflare.com → Turnstile → your widget).
# This is the public site key, safe to ship in the bundle. Signup's bot
# protection is dormant until this is set AND the matching secret key is
# pasted into the Supabase dashboard under Authentication → Settings →
# Bot and Abuse Protection → Turnstile.
VITE_TURNSTILE_SITE_KEY=

# Web push. Generate the pair once with:  npx web-push generate-vapid-keys
# Only the PUBLIC half belongs here — it ships in the client bundle by design.
# The private key is a Supabase function secret (VAPID_PRIVATE_KEY) and must
# never appear in this file or in the browser.
# Leave blank to ship with push switched off; the Settings toggle hides itself.
VITE_VAPID_PUBLIC_KEY=
