# Copy this file to .env and fill in real values. Never commit .env itself.

# Supabase project settings (Project Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapbox public token (mapbox.com → Account → Tokens). This is a client-exposed
# token by design (Mapbox scopes it), not a secret — safe to ship in the bundle.
VITE_MAPBOX_TOKEN=

# NOTE: the Resend API key is server-side only (used by the Supabase `notify`
# Edge Function), never a VITE_ variable — it must never ship to the client.
# Set it via `supabase secrets set RESEND_API_KEY=...` instead.
