{
  "name": "toolber",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "biome format --fix",
    "test:ava": "ava",
    "test:ava:watch": "ava --watch",
    "test:ava:coverage": "c8 ava",
    "test:lint": "biome lint .",
    "test:lint:fix": "biome lint --fix .",
    "test:types": "tsc --noEmit",
    "test:knip": "knip",
    "test:security": "semgrep scan --config auto --error --quiet .",
    "test:audit": "npm audit --audit-level high",
    "test:no-direct-pickup-location": "bash scripts/test-no-direct-pickup-location.sh",
    "test:all": "bash scripts/test-all.sh",
    "supabase:db:push": "supabase db push",
    "supabase:db:push:dry-run": "supabase db push --dry-run",
    "supabase:functions:deploy": "supabase functions deploy notify",
    "categories": "node scripts/generate-categories.mjs"
  },
  "ava": {
    "files": [
      "src/**/*.test.js",
      "src/**/*.test.jsx",
      "test/**/*.test.js",
      "!node_modules/**",
      "!dist/**"
    ],
    "extensions": {
      "js": true,
      "jsx": "module"
    },
    "nodeArguments": [
      "--import=tsx",
      "--import=global-jsdom/register",
      "--import=./test/support/mock-supabase.mjs"
    ],
    "environmentVariables": {
      "NODE_ENV": "test"
    },
    "workerThreads": false
  },
  "c8": {
    "include": [
      "src/**/*.{js,jsx}"
    ],
    "exclude": [
      "**/*.test.*",
      "test/**",
      "src/main.jsx",
      "src/components/ToolMap.jsx"
    ],
    "reporter": [
      "text",
      "html"
    ],
    "reportsDir": "coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "mapbox-gl": "^3.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@eslint/js": "^9.15.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "ava": "^6.4.1",
    "c8": "^11.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "global-jsdom": "^27.0.0",
    "globals": "^15.12.0",
    "jsdom": "^27.4.0",
    "knip": "^5.88.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1"
  }
}
